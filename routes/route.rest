# Get All Registered Players

GET http://localhost:5134/auth/

###

# Get a Player by ID

# Replace {playerId} with an actual player ID from your database
GET http://localhost:5134/auth/{playerId}

###

# Update a Player's Details

# Replace {playerId} with an actual player ID from your database
PATCH http://localhost:5134/auth/{playerId}
Content-Type: application/json

{
  "gradeLevel": "8th Grade",
  "phone": "555-0000"
}

###

# Delete a Player

# Replace {playerId} with an actual player ID from your database
DELETE http://localhost:5134/auth/{playerId}

