Content-Type: application/json

{
  "playerFirstName": "John",
  "playerLastName": "Doe",
  "parentName": "Jane Doe",
  "email": "jane.doe@example.com",
  "gradeLevel": "5th Grade",
  "phone": "555-1234",
  "gender": "Male",
  "street": "123 Main St",
  "town": "Anytown",
  "state": "CA",
  "zip": "12345",
  "emergencyContactName": "Jim Smith",
  "emergencyContactNumber": "555-5678"
}

